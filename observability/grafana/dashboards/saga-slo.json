{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Saga SLO Overview",
  "uid": "saga-slo",
  "tags": ["choreography-saga", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "SLO: Success / Compensation / Payment",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Saga success rate (SLO ≥ 99%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.95 },
            { "color": "green", "value": 0.99 }
          ] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(saga_terminal_total{outcome=\"confirmed\"}[5m])) / clamp_min(sum(rate(saga_terminal_total[5m])), 1e-9)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Compensation rate (SLO ≤ 5%, warn > 20%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.05 },
            { "color": "red", "value": 0.20 }
          ] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(saga_terminal_total{outcome=\"cancelled\"}[5m])) / clamp_min(sum(rate(saga_terminal_total[5m])), 1e-9)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Payment failure rate (SLO ≤ 5%, warn > 20%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.05 },
            { "color": "red", "value": 0.20 }
          ] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(payment_result_total{result=\"failed\"}[5m])) / clamp_min(sum(rate(payment_result_total[5m])), 1e-9)"
        }
      ]
    },
    {
      "type": "row",
      "title": "Saga throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Terminal sagas / s by outcome",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{outcome}}", "expr": "sum by (outcome) (rate(saga_terminal_total[1m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Payment outcomes / s by result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{result}}", "expr": "sum by (result) (rate(payment_result_total[1m]))" }
      ]
    },
    {
      "type": "row",
      "title": "Per-service RED-style rates",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "type": "timeseries",
      "title": "Inventory reserve outcomes / s by result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{result}}", "expr": "sum by (result) (rate(inventory_reserve_total[1m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Span request rate by service (Tempo span-metrics)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{service}}", "expr": "sum by (service) (rate(traces_spanmetrics_calls_total[1m]))" }
      ]
    },
    {
      "type": "row",
      "title": "SLO: Latency & Outbox lag",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }
    },
    {
      "type": "timeseries",
      "title": "Saga end-to-end p95 latency (SLO ≤ 2s, warn > 4s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 2 },
            { "color": "red", "value": 4 }
          ] }
        }
      },
      "targets": [
        { "refId": "A", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(saga_duration_seconds_bucket[5m])))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "ReserveStock p95 latency (SLO ≤ 250ms, warn > 750ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.25 },
            { "color": "red", "value": 0.75 }
          ] }
        }
      },
      "targets": [
        { "refId": "A", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(reserve_stock_server_duration_seconds_bucket[5m])))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox pending backlog by service (warn > 100)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 100 }
          ] }
        }
      },
      "targets": [
        { "refId": "A", "legendFormat": "{{service_name}}", "expr": "max by (service_name) (outbox_pending)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox publish-lag p95 by service (SLO ≤ 1s, warn > 10s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ] }
        }
      },
      "targets": [
        { "refId": "A", "legendFormat": "{{service_name}}", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(outbox_publish_lag_seconds_bucket[5m])))" }
      ]
    }
  ]
}
